# Local development only. These point at infra/docker/docker-compose.yml, which runs a mock OIDC
# provider that will sign anything — it is not an identity-provider decision (P-008) and must never
# be used outside loopback.
OIDC_ISSUER=http://localhost:8081/default
OIDC_CLIENT_ID=geo-housing-admin-web
OIDC_CLIENT_SECRET=local-dev-only-not-a-secret
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8080
