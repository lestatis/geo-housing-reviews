{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./local-data/**)",
      "Bash(sudo *)",
      "Bash(doas *)",
      "Bash(pkexec *)",
      "Bash(su *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-privileged-commands.sh"
          }
        ]
      }
    ]
  }
}
